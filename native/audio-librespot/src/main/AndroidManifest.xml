<?xml version="1.0" encoding="utf-8"?>
<!-- Playback needs network access: Spotify access points (audio keys/streams)
     and accounts.spotify.com for the one-time OAuth. Library manifests merge
     into the consuming app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The librespot OAuth opens the Spotify consent page in the browser. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application>
        <!-- Media playback foreground service + notification controls. -->
        <service
            android:name=".playback.LocalPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- In-app Spotify consent page (WebView). Used instead of the system
             browser because some devices have no browser that can complete the
             loopback redirect. configChanges keeps the page alive on rotation. -->
        <activity
            android:name=".LibrespotAuthActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
